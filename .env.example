# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
# Read at runtime (never baked into the build). The older NEXT_PUBLIC_* names still work.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only — never commit it or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run
# `npm run setup` so Supabase allow-lists it for auth email redirects.
# SITE_URL=https://your-app.com

# Optional: overrides the logo from src/config/branding.ts (absolute URL or /public path).
# BRAND_LOGO_URL=

# The client workspace this deployment serves (set by the back-office). Required when several
# clients share one Supabase project; unset = a dedicated project holding a single workspace.
# WORKSPACE_ID=

# One deployment for every client (set by the back-office, instead of WORKSPACE_ID): the secret
# this app shows the back office to ask which client a host belongs to. With it and BACKOFFICE_URL,
# and no WORKSPACE_ID, each request is served for the client of its host; sign-in is then always the
# back office's, and SITE_URL, BRAND_LOGO_URL and AUTH_VIA_BACKOFFICE are not read.
# APP_RESOLVER_TOKEN=

# The Yelema back office's public origin (set by the back-office). It serves the expert catalogue:
# names, roles, photos, videos. Optional: without it experts are shown by their profile name.
# BACKOFFICE_URL=https://admin.yelema.ai

# Yelema's own Composio project key (set by the back-office). Server-only: the Connecteurs tab and
# the experts' tool proxy (/api/composio-mcp) run on it, for instances wired for it.
# COMPOSIO_API_KEY=

# Who signs users in and says what they see (set by the back-office). "true": the Yelema back office
# does, through its /api/v1/app routes; it needs BACKOFFICE_URL and WORKSPACE_ID. Unset: Supabase
# Auth and this app's own tables, as before. Switch a deployment back by removing it and redeploying.
# AUTH_VIA_BACKOFFICE=true
