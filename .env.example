# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
# Read at runtime (never baked into the build). The older NEXT_PUBLIC_* names still work.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only — never commit it or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run
# `npm run setup` so Supabase allow-lists it for auth email redirects.
# SITE_URL=https://your-app.com

# Optional: overrides the logo from src/config/branding.ts (absolute URL or /public path).
# BRAND_LOGO_URL=

# The client workspace this deployment serves (set by the back-office). Required when several
# clients share one Supabase project; unset = a dedicated project holding a single workspace.
# WORKSPACE_ID=
