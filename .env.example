# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Yelema's own Composio project (platform.composio.dev -> project -> API key). Server-only: the
# Connecteurs page and the experts' tool proxy (/api/composio-mcp) both run on it.
COMPOSIO_API_KEY=

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only (no NEXT_PUBLIC_ prefix) — never commit it
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run
# `npm run setup` so Supabase allow-lists it for auth email redirects.
# NEXT_PUBLIC_SITE_URL=https://your-app.com

# Optional: send emails (admin invites, password resets) through Resend. Without a key nothing
# fails: the app shows a "Copier le lien" button instead. Re-run `npm run setup` after setting it
# so Supabase's own auth emails go through Resend too. The sender's domain must be verified there.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Yelema <no-reply@yelema.ai>
# AgentMail API Key (https://agentmail.to) - Enables email inboxes, messaging, and webhooks for each expert
AGENTMAIL_API_KEY=
